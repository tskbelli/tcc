<%- include('cabecalho.ejs', { tituloPagina: filme.titulo }) %>

<section class="detalhe-hero">
    <div class="container py-5">
        <div class="row g-5 align-items-center">
            <div class="col-md-4 col-lg-3">
                <div class="detalhe-capa">
                    <% if (filme.capaUrl) { %>
                        <img src="<%= filme.capaUrl %>" alt="Capa de <%= filme.titulo %>">
                    <% } else { %>
                        <span class="capa-vazia"><i class="bi bi-camera-reels"></i><small>IFCine</small></span>
                    <% } %>
                </div>
            </div>
            <div class="col-md-8 col-lg-9">
                <span class="badge-genero"><%= filme.genero %></span>
                <h1 class="display-4 fw-bold mt-3"><%= filme.titulo %></h1>
                <p class="meta-filme fs-6"><%= filme.ano %> · <%= filme.duracao %> min<%= filme.diretor ? ' · Direção: ' + filme.diretor : '' %><%= filme.edicao ? ' · ' + filme.edicao : '' %></p>
                <p class="sinopse"><%= filme.sinopse %></p>
                <div class="d-flex flex-wrap align-items-center gap-3 mt-4">
                    <a class="btn btn-ifcine btn-lg" href="<%= filme.link %>" target="_blank" rel="noopener noreferrer"><i class="bi bi-play-fill"></i> Assistir</a>
                    <div class="nota-grande"><span><i class="bi bi-star-fill"></i> <%= media ? media.toFixed(1) : '—' %></span><small><%= quantidade %> avaliação<%= quantidade === 1 ? '' : 'ões' %></small></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container py-5">
    <div class="row g-5">
        <div class="col-lg-5">
            <div class="painel-form sticky-lg-top">
                <h2 class="h4"><%= avaliacaoUsuario ? 'Atualize sua avaliação' : 'Avalie este filme' %></h2>
                <% if (usuarioLogado) { %>
                    <form action="/filmes/<%= filme.id %>/avaliar" method="post">
                        <fieldset class="mb-3">
                            <legend class="form-label">Sua nota</legend>
                            <div class="star-rating">
                                <% for (let nota = 5; nota >= 1; nota--) { %>
                                    <input type="radio" id="estrela<%= nota %>" name="nota" value="<%= nota %>" <%= avaliacaoUsuario && avaliacaoUsuario.nota === nota ? 'checked' : '' %> required>
                                    <label for="estrela<%= nota %>" title="<%= nota %> estrela<%= nota === 1 ? '' : 's' %>">★</label>
                                <% } %>
                            </div>
                        </fieldset>
                        <div class="mb-3">
                            <label for="comentario" class="form-label">Comentário (opcional)</label>
                            <textarea id="comentario" name="comentario" class="form-control" rows="5" maxlength="800" placeholder="Conte o que achou"><%= avaliacaoUsuario ? avaliacaoUsuario.comentario : '' %></textarea>
                            <div class="form-text">Máximo de 800 caracteres.</div>
                        </div>
                        <button class="btn btn-ifcine w-100" type="submit">Salvar avaliação</button>
                    </form>
                <% } else { %>
                    <p class="text-secondary">Entre na sua conta para dar uma nota e escrever um comentário.</p>
                    <a class="btn btn-ifcine w-100" href="/login">Entrar para avaliar</a>
                <% } %>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h4 mb-0">Avaliações da comunidade</h2>
                <span class="badge-genero"><%= quantidade %> publicada<%= quantidade === 1 ? '' : 's' %></span>
            </div>
            <% if (!avaliacoes.length) { %>
                <div class="estado-vazio compacto"><i class="bi bi-chat-square-text"></i><p>Seja a primeira pessoa a avaliar.</p></div>
            <% } %>
            <div class="d-grid gap-3">
                <% for (const avaliacao of avaliacoes) { %>
                    <article class="review-card">
                        <div class="d-flex justify-content-between gap-3">
                            <div><strong><%= avaliacao.usuario.nome %></strong><div class="estrelas" aria-label="<%= avaliacao.nota %> de 5 estrelas"><% for (let i = 1; i <= 5; i++) { %><i class="bi <%= i <= avaliacao.nota ? 'bi-star-fill' : 'bi-star' %>"></i><% } %></div></div>
                            <small class="text-secondary"><%= new Date(avaliacao.updatedAt).toLocaleDateString('pt-BR') %></small>
                        </div>
                        <% if (avaliacao.comentario) { %><p class="mb-0 mt-3"><%= avaliacao.comentario %></p><% } %>
                    </article>
                <% } %>
            </div>
        </div>
    </div>
</section>

<%- include('rodape.ejs') %>
