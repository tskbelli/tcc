<%- include('cabecalho.ejs', { tituloPagina: filme.titulo }) %>

<section class="detalhe-hero">
    <div class="container py-5">
        <div class="row g-5 align-items-center">
            <div class="col-md-4 col-lg-3">
                <div class="detalhe-capa">
                    <% if (filme.capaSrc) { %>
                        <img src="<%= filme.capaSrc %>" alt="Capa de <%= filme.titulo %>">
                    <% } else { %>
                        <span class="capa-vazia"><i class="bi bi-camera-reels"></i><small>IFCine</small></span>
                    <% } %>
                </div>
            </div>
            <div class="col-md-8 col-lg-9">
                <span class="badge-genero"><%= filme.genero %></span>
                <h1 class="display-4 fw-bold mt-3"><%= filme.titulo %></h1>
                <p class="meta-filme fs-6"><%= filme.ano %> · <%= formatarDuracao(filme) %><%= filme.diretor ? ' · Direção: ' + filme.diretor : '' %><%= filme.edicao ? ' · ' + filme.edicao : '' %></p>
                <p class="sinopse"><%= filme.sinopse %></p>
                <div class="d-flex flex-wrap align-items-center gap-3 mt-4">
                    <a class="btn btn-ifcine btn-lg" href="<%= filme.link %>" target="_blank" rel="noopener noreferrer"><i class="bi bi-play-fill"></i> Assistir</a>
                    <div class="nota-grande"><%- include('../partials/estrelas.ejs', { valor: media }) %><small><%= quantidade %> <%= quantidade === 1 ? 'avaliação' : 'avaliações' %></small></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container py-5">
    <div class="row g-5">
        <div class="col-lg-5">
            <div class="painel-form sticky-lg-top">
                <h2 class="h4"><%= avaliacaoUsuario ? 'Atualize sua avaliação' : 'Avalie este filme' %></h2>
                <% if (usuarioLogado) { %>
                    <% if (avaliacaoUsuario) { %>
                        <p class="text-secondary">Você já avaliou este filme com <strong><%= formatarNota(avaliacaoUsuario.nota) %> estrelas</strong>. Ao salvar, sua avaliação será atualizada.</p>
                    <% } %>
                    <form action="/filmes/<%= filme.id %>/avaliar" method="post">
                        <fieldset class="mb-3" aria-describedby="ajuda-estrelas">
                            <legend class="form-label">Sua nota</legend>
                            <div class="star-rating">
                                <% for (let metade = 10; metade >= 1; metade--) { const nota = metade / 2; %>
                                    <input type="radio" id="estrela<%= metade %>" name="nota" value="<%= nota %>" aria-label="<%= formatarNota(nota) %> <%= nota === 1 ? 'estrela' : 'estrelas' %>" <%= avaliacaoUsuario && avaliacaoUsuario.nota === nota ? 'checked' : '' %> required>
                                    <label class="<%= metade % 2 ? 'metade-esquerda' : 'metade-direita' %>" for="estrela<%= metade %>" title="<%= formatarNota(nota) %> estrelas">
                                        <span class="icone-vazio" aria-hidden="true">☆</span><span class="icone-cheio" aria-hidden="true">★</span>
                                    </label>
                                <% } %>
                            </div>
                            <output id="nota-selecionada" class="d-block small estrelas mt-2" aria-live="polite"><%= avaliacaoUsuario ? 'Sua nota: ' + formatarNota(avaliacaoUsuario.nota) + ' / 5' : 'Escolha sua nota' %></output>
                            <div id="ajuda-estrelas" class="form-text">Toque na metade esquerda para meia estrela e na direita para uma inteira. Pelo teclado, use as setas.</div>
                        </fieldset>
                        <div class="mb-3">
                            <label for="comentario" class="form-label">Comentário (opcional)</label>
                            <textarea id="comentario" name="comentario" class="form-control" rows="5" maxlength="800" placeholder="Conte o que achou"><%= avaliacaoUsuario ? avaliacaoUsuario.comentario : '' %></textarea>
                            <div class="form-text">Máximo de 800 caracteres.</div>
                        </div>
                        <button class="btn btn-ifcine w-100" type="submit"><%= avaliacaoUsuario ? 'Atualizar avaliação' : 'Salvar avaliação' %></button>
                    </form>
                <% } else { %>
                    <p class="text-secondary">Entre na sua conta para dar uma nota e escrever um comentário.</p>
                    <a class="btn btn-ifcine w-100" href="/login">Entrar para avaliar</a>
                <% } %>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h4 mb-0">Avaliações da comunidade</h2>
                <span class="badge-genero"><%= quantidade %> publicada<%= quantidade === 1 ? '' : 's' %></span>
            </div>
            <% if (!avaliacoes.length) { %>
                <div class="estado-vazio compacto"><i class="bi bi-chat-square-text"></i><p>Seja a primeira pessoa a avaliar.</p></div>
            <% } %>
            <div class="d-grid gap-3">
                <% for (const avaliacao of avaliacoes) { %>
                    <article class="review-card">
                        <div class="d-flex justify-content-between gap-3">
                            <div><strong><%= avaliacao.usuario.nome %></strong><div><%- include('../partials/estrelas.ejs', { valor: avaliacao.nota }) %></div></div>
                            <small class="text-secondary"><%= new Date(avaliacao.updatedAt).toLocaleDateString('pt-BR') %></small>
                        </div>
                        <% if (avaliacao.comentario) { %><p class="mb-0 mt-3"><%= avaliacao.comentario %></p><% } %>
                    </article>
                <% } %>
            </div>
        </div>
    </div>
</section>

<script src="/js/avaliacao-form.js" defer></script>
<%- include('rodape.ejs') %>
