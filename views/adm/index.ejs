<%- include('cabecalho.ejs', { tituloPagina: 'Painel' }) %>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div><span class="eyebrow">Visão geral</span><h1 class="h2 mb-0">Painel administrativo</h1><p class="text-secondary mb-0">Gerencie o conteúdo e a comunidade do IFCine.</p></div>
