<%- include('../catalogo/cabecalho.ejs', { tituloPagina: 'Meu perfil' }) %>

<section class="container py-5">
    <div class="perfil-cabecalho">
        <div class="perfil-avatar"><%= perfil.nome.charAt(0).toUpperCase() %></div>
        <div>
            <span class="eyebrow">Meu perfil</span>
            <h1 class="h2 mb-1"><%= perfil.nome %></h1>
            <p class="text-secondary mb-1"><%= perfil.email %></p>
            <small class="text-secondary">Conta criada em <%= new Date(perfil.dataCadastro).toLocaleDateString('pt-BR') %></small>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-5 mb-3">
        <div><span class="eyebrow">Sua atividade</span><h2 class="h3 mb-0">Histórico de avaliações</h2></div>
        <span class="badge-genero"><%= avaliacoes.length %> registro<%= avaliacoes.length === 1 ? '' : 's' %></span>
    </div>

    <% if (!avaliacoes.length) { %>
        <div class="estado-vazio"><i class="bi bi-star"></i><h3>Nenhuma avaliação ainda</h3><p>Explore o catálogo e dê sua primeira nota.</p><a class="btn btn-ifcine" href="/">Ver catálogo</a></div>
    <% } %>

    <div class="d-grid gap-3">
        <% for (const avaliacao of avaliacoes) { %>
            <article class="historico-card">
                <div class="historico-capa">
                    <% if (avaliacao.filme.capaUrl) { %><img src="<%= avaliacao.filme.capaUrl %>" alt=""><% } else { %><i class="bi bi-camera-reels"></i><% } %>
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex flex-wrap justify-content-between gap-2">
                        <h3 class="h5 mb-1"><a href="/filmes/<%= avaliacao.filme.id %>"><%= avaliacao.filme.titulo %></a></h3>
                        <span class="estrelas"><i class="bi bi-star-fill"></i> <%= avaliacao.nota %>/5</span>
                    </div>
                    <p class="text-secondary small mb-2">Atualizada em <%= new Date(avaliacao.updatedAt).toLocaleDateString('pt-BR') %> · <%= avaliacao.ativo ? 'Publicada' : 'Ocultada pela moderação' %></p>
                    <% if (avaliacao.comentario) { %><p class="mb-0"><%= avaliacao.comentario %></p><% } %>
                </div>
                <a class="btn btn-outline-light btn-sm" href="/filmes/<%= avaliacao.filme.id %>">Editar</a>
            </article>
        <% } %>
    </div>
</section>

<%- include('../catalogo/rodape.ejs') %>
